{
  "manifest_version": 3,
  "name": "Simplifier 숏폼 리서치 자동화",
  "version": "0.4.0",
  "description": "숏폼 대본 브리프를 제미나이 딥리서치에 넣고, 완료되면 결과를 클립보드로 가져옵니다.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabs", "notifications"],
  "host_permissions": ["https://gemini.google.com/*", "https://api.github.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png"
  }
}
